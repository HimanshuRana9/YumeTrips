<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>YumeTrips Web Application</display-name>

    <!-- ========== SERVLET DECLARATIONS ========== -->
    <servlet>
        <servlet-name>HomeServlet</servlet-name>
        <servlet-class>com.yume.trips.servlet.HomeServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.yume.trips.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.yume.trips.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DestinationsServlet</servlet-name>
        <servlet-class>com.yume.trips.servlet.DestinationsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>HotelsServlet</servlet-name>
        <servlet-class>com.yume.trips.servlet.HotelsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PlannerServlet</servlet-name>
        <servlet-class>com.yume.trips.servlet.PlannerServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>RouteMapServlet</servlet-name>
        <servlet-class>com.yume.trips.servlet.RouteMapServlet</servlet-class>
    </servlet>

    <!-- ========== SERVLET MAPPINGS ========== -->
    <servlet-mapping>
        <servlet-name>HomeServlet</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DestinationsServlet</servlet-name>
        <url-pattern>/destinations</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>HotelsServlet</servlet-name>
        <url-pattern>/hotels</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PlannerServlet</servlet-name>
        <url-pattern>/planner</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>RouteMapServlet</servlet-name>
        <url-pattern>/route-map</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

</web-app>
